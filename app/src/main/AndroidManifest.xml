<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Special "Usage access" permission — not grantable through a normal runtime
      dialog. The user must flip it on manually in system Settings; we deep-link
      them there from the in-app permission screen (see PermissionScreen.kt).
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Android 11+ hides other installed apps from us by default — usage access
      does NOT lift that (an earlier version of this comment wrongly claimed it
      did, which is why "Time in your apps" showed only a couple of apps).
      Declaring the launcher intent makes every app with a home-screen icon
      visible, so we can resolve its name and icon, without needing the
      Play-restricted QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".StillApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Still">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Still">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.StillWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/still_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StillWideWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/still_wide_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StillMiniWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_mini_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/still_mini_widget_info" />
        </receiver>

    </application>

</manifest>
